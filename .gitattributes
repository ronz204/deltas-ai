# Let git detect text files and normalize them to LF in the repository.
* text=auto

# The harness is read by Claude Code and run by POSIX sh, so these stay LF
# in the working copy on every platform, never CRLF.
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Go source and the git hooks installed into projects stay LF too: a CRLF
# in a hook's shebang breaks it on Unix.
*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
.githooks/*        text eol=lf
source/harness/core/githooks/* text eol=lf

# Binary files git must not touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
