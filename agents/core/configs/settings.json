{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(delta status)",
      "Bash(delta stale)",
      "Bash(delta ready *)",
      "Bash(delta check *)",
      "Bash(delta lint *)",
      "Bash(delta spec *)",
      "Bash(delta link *)",
      "Bash(delta built *)",
      "Bash(delta budget)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(delta approve *)",
      "Bash(delta init)",
      "Bash(delta update)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push *)",
      "Bash(git pull *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "delta hook" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "delta hook" }] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "delta hook" }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "delta hook" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "delta hook" }] }
    ]
  }
}
