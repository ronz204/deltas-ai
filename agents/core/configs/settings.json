{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "Skill(update-config)",
      "Bash(curl *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(powershell *)",
      "Bash(docker exec *)",
      "Bash(docker compose *)"
    ],
    "ask": [
      "Bash(delta approve *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push *)",
      "Bash(git pull *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "delta hook", "timeout": 20 }]
      }
    ]
  }
}
